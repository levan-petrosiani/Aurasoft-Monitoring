{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "MockBank": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "http://localhost:7080/",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "MockBank (always show login page)": {
      "commandName": "Project",
      "launchBrowser": false,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MockBank__AutoApprove": "never"
      }
    }
  }
}

<span class="badge badge-@Css">@Text</span>

@code {
    [Parameter] public Outcome? Outcome { get; set; }

    [Parameter] public RunStatus? Status { get; set; }

    private string Text => Outcome?.ToString() ?? Status?.ToString() ?? "";

    private string Css => (Outcome, Status) switch
    {
        (Engine.Running.Outcome.Passed, _) or (_, RunStatus.Completed) => "pass",
        (Engine.Running.Outcome.Failed, _) or (_, RunStatus.Failed) => "fail",
        (Engine.Running.Outcome.Error, _) => "error",
        (_, RunStatus.Running) => "running",
        (_, RunStatus.Queued) => "queued",
        _ => "muted",
    };
}

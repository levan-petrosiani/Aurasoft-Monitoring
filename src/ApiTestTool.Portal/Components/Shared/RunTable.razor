@if (Runs.Count == 0)
{
    <p class="muted">No runs yet. <a href="/run/new">Start one</a>.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr><th>Started</th><th>Bank</th><th>Suites</th><th>Status</th><th>Passed</th><th>Failed</th><th>Errors</th><th>Blocked</th><th>Pass rate</th></tr>
        </thead>
        <tbody>
            @foreach (var run in Runs)
            {
                var r = run.Record;
                <tr class="clickable" @onclick="() => Open(run)">
                    <td>@r.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                    <td>@(r.BankName ?? r.Request.Bank) <span class="muted small">@r.Request.Bank</span></td>
                    <td class="small">@(r.Request.Suites.Count == 0 ? "all" : string.Join(", ", r.Request.Suites))</td>
                    <td><OutcomeBadge Status="r.Status" /></td>
                    <td class="text-pass">@r.Passed</td>
                    <td class="@(r.Failed > 0 ? "text-fail" : "")">@r.Failed</td>
                    <td class="@(r.Errors > 0 ? "text-error" : "")">@r.Errors</td>
                    <td>@r.Blocked</td>
                    <td>@(r.Status == RunStatus.Completed ? $"{r.PassRate.ToString("0.#", CultureInfo.InvariantCulture)}%" : "")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter, EditorRequired] public List<PortalRun> Runs { get; set; } = [];

    private void Open(PortalRun run) => Nav.NavigateTo("/runs/" + run.Id);
}

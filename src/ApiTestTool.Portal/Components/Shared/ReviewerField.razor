@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage Storage

@* The portal has no login yet: reviewers type their name once; it is kept in this browser and recorded with every review. *@
<div class="reviewer">
    <label class="label" for="reviewer">Reviewing as</label>
    <input id="reviewer" class="field field-inline" placeholder="Your name" value="@Value" @onchange="OnChange" />
</div>

@code {
    private const string Key = "aqt.reviewer";

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var stored = await Storage.GetAsync<string>(Key);
            if (stored.Success && !string.IsNullOrWhiteSpace(stored.Value))
            {
                Value = stored.Value;
                await ValueChanged.InvokeAsync(Value);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Unreadable (e.g. data-protection keys changed): the reviewer just types the name again.
        }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        Value = (e.Value as string)?.Trim();
        await ValueChanged.InvokeAsync(Value);
        if (!string.IsNullOrEmpty(Value))
            await Storage.SetAsync(Key, Value);
        else
            await Storage.DeleteAsync(Key);
    }
}

@page "/standards"
@using ApiTestTool.AI
@using ApiTestTool.Store
@using ApiTestTool.Store.Entities
@implements IDisposable
@inject RuleService Rules
@inject NavigationManager Nav

<PageTitle>Standards · API Test Portal</PageTitle>

<div class="title-row">
    <h1>Standards</h1>
    <ReviewerField @bind-Value="_reviewer" />
</div>

@if (_docs.Count == 0)
{
    <div class="alert alert-warn">No standards in the database yet. Run <code>aqt standards fetch</code> and <code>aqt standards ingest</code>.</div>
    return;
}

<div class="std-layout">
    <aside class="std-side">
        <form class="std-search" @onsubmit="Search">
            <input type="search" placeholder="Search clauses (English or Georgian)" @bind="_query" />
            <button class="btn btn-small" type="submit">Search</button>
        </form>

        <div class="filter-row">
            @foreach (var d in _docs)
            {
                <button class="chip @(_doc?.Id == d.Id && _doc.Version == d.Version && _hits is null ? "chip-on" : "")" title="@d.Title" @onclick="() => OpenDoc(d)">@d.Id <span class="muted">@d.Version</span></button>
            }
        </div>

        @if (_hits is not null)
        {
            <p class="muted small">@_hits.Count result(s) for “@_lastQuery” · <a href="" @onclick="ClearSearch" @onclick:preventDefault>back to outline</a></p>
            <ul class="std-outline">
                @foreach (var h in _hits)
                {
                    <li class="@(_clause?.Key == h.Clause.Key ? "on" : "")" @onclick="() => OpenClause(h.Clause.Key, true)">
                        <code>@h.Clause.Standard @h.Clause.Number</code> @h.Clause.Title
                        <span class="muted small">@(h.ByWords && h.ByMeaning ? "words + meaning" : h.ByWords ? "words" : "meaning")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <ul class="std-outline">
                @foreach (var c in _outline)
                {
                    <li class="lvl-@Math.Min(c.Level, 5) @(_clause?.Key == c.Key ? "on" : "")" @onclick="() => OpenClause(c.Key, true)">
                        <code>@c.Number</code> @c.Title
                        @if (_ruleCounts.TryGetValue(c.Key, out var n)) { <span class="chip">@n</span> }
                    </li>
                }
            </ul>
        }
    </aside>

    <section class="std-main">
        @if (_clause is null)
        {
            <p class="muted">Pick a clause to read it and draft rules from it.</p>
        }
        else
        {
            <p class="muted small">
                @_clause.Standard @_clause.Version
                @foreach (var a in _ancestors) { <span> › @a.Number @a.Title</span> }
            </p>
            <h2>@_clause.Number @_clause.Title @if (_clause.Page is { } p) { <span class="muted small">p. @p</span> }</h2>
            <pre class="clause-text">@(_clause.Text.Length == 0 ? "(no text of its own — see the sub-sections)" : _clause.Text)</pre>

            <div class="actions">
                @if (Rules.DraftingProvider(_clause.Key) is { } drafting)
                {
                    <span class="muted small">Drafting rules with @(drafting == AiProviders.Ollama ? "the local model (about a minute)" : "Claude")…</span>
                }
                else
                {
                    <button class="btn btn-small btn-primary" disabled="@string.IsNullOrWhiteSpace(_reviewer)" @onclick="() => Draft(AiProviders.Anthropic)" title="@Rules.ModelFor(AiProviders.Anthropic)">Draft rules with Claude</button>
                    <button class="btn btn-small btn-ghost" disabled="@string.IsNullOrWhiteSpace(_reviewer)" @onclick="() => Draft(AiProviders.Ollama)">Local (@Rules.ModelFor(AiProviders.Ollama))</button>
                    @if (string.IsNullOrWhiteSpace(_reviewer)) { <span class="muted small">Enter your name at the top first.</span> }
                }
            </div>

            @if (Rules.LastDraft(_clause.Key) is { } last)
            {
                <p class="small @(last.Status == "ok" ? "muted" : "text-fail")">
                    Last draft: @(last.Status == "ok" ? $"{last.Rules.Count(r => r.Status == "draft")} for review, {last.Rules.Count(r => r.Status == "invalid")} rejected by the checks" : last.Error)
                    @if (!string.IsNullOrWhiteSpace(last.Skipped)) { <span> · not drafted: @last.Skipped</span> }
                </p>
            }

            <h3>Rules from this clause (@_clauseRules.Count)</h3>
            @foreach (var r in _clauseRules)
            {
                <RuleCard Rule="r" Reviewer="@_reviewer" Changed="LoadClauseRules" />
            }
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "clause")] public string? ClauseKey { get; set; }

    private List<StandardDocumentEntity> _docs = [];
    private StandardDocumentEntity? _doc;
    private List<ClauseEntity> _outline = [];
    private Dictionary<string, int> _ruleCounts = [];
    private ClauseEntity? _clause;
    private List<ClauseEntity> _ancestors = [];
    private List<RuleEntity> _clauseRules = [];
    private List<ClauseHit>? _hits;
    private string _query = "", _lastQuery = "";
    private string? _reviewer;

    protected override async Task OnInitializedAsync()
    {
        Rules.Changed += OnChanged;
        _docs = await Rules.Store.ListStandardsAsync();
        await CountRules();

        var key = ClauseKey;
        var doc = key is null ? _docs.FirstOrDefault() : _docs.FirstOrDefault(d => key.StartsWith($"{d.Id}:{d.Version}:", StringComparison.Ordinal)) ?? _docs.FirstOrDefault();
        if (doc is not null)
            await OpenDoc(doc);
        if (key is not null)
            await OpenClause(key, updateUrl: false); // the URL already says so; navigating while prerendering would redirect
    }

    private async Task OpenDoc(StandardDocumentEntity doc)
    {
        _doc = doc;
        _hits = null;
        _outline = await Rules.Store.GetOutlineAsync(doc.Id, doc.Version);
    }

    private async Task OpenClause(string key, bool updateUrl)
    {
        _clause = await Rules.Store.GetClauseAsync(key);
        _ancestors = _clause is null ? [] : await Rules.Store.GetAncestorsAsync(_clause);
        await LoadClauseRules();
        if (updateUrl)
            Nav.NavigateTo($"/standards?clause={Uri.EscapeDataString(key)}", replace: true); // shareable link to the clause
    }

    private async Task LoadClauseRules()
    {
        _clauseRules = _clause is null ? [] : await Rules.Store.ListRulesAsync(clauseKey: _clause.Key);
        await CountRules();
    }

    private async Task CountRules() =>
        _ruleCounts = (await Rules.Store.ListRulesAsync()).Where(r => r.Status is "draft" or "approved").GroupBy(r => r.ClauseKey).ToDictionary(g => g.Key, g => g.Count());

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_query))
            return;
        _lastQuery = _query.Trim();
        _hits = await Rules.SearchAsync(_lastQuery, null);
    }

    private void ClearSearch() => _hits = null;

    private void Draft(string provider) => Rules.StartDraft(_clause!.Key, provider, $"{_reviewer} (portal)");

    private void OnChanged(string key)
    {
        if (_clause is not null)
            InvokeAsync(async () => { await LoadClauseRules(); StateHasChanged(); });
    }

    public void Dispose() => Rules.Changed -= OnChanged;
}

@page "/runs/{Id}"
@implements IDisposable
@inject RunService RunService
@inject NavigationManager Nav

<PageTitle>Run @Id · API Test Portal</PageTitle>

@if (_run is null)
{
    <h1>Run not found</h1>
    <p><a href="/runs">Back to runs</a></p>
    return;
}

@{
    var r = _run.Record;
    var completed = _run.Completed;
}

<div class="title-row">
    <h1>@(r.BankName ?? r.Request.Bank) <span class="muted">· @r.Request.Bank</span></h1>
    <OutcomeBadge Status="r.Status" />
</div>
<p class="muted small">
    Run <code>@r.Id</code> · created @r.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
    · suites: @(r.Request.Suites.Count == 0 ? "all" : string.Join(", ", r.Request.Suites))
    @if (r.Request.ScenarioIds.Count > 0) { <span> · scenarios: @string.Join(", ", r.Request.ScenarioIds)</span> }
    @if (r.Request.UseMockBank) { <span> · built-in MockBank</span> }
    @if (r.Request.AutoSca) { <span> · automatic SCA</span> }
</p>

<div class="actions">
    @if (_run.IsActive)
    {
        <button class="btn" @onclick="() => RunService.Cancel(Id)">Cancel run</button>
    }
    else
    {
        <button class="btn btn-primary" @onclick="RunAgain">Run again</button>
        @if (_run.Result is not null)
        {
            <a class="btn btn-ghost" href="/runs/@Id/files/report.html" target="_blank">HTML report</a>
            <a class="btn btn-ghost" href="/runs/@Id/files/summary.json" target="_blank">summary.json</a>
            <a class="btn btn-ghost" href="/runs/@Id/files/junit.xml" target="_blank">junit.xml</a>
        }
        <button class="btn btn-ghost btn-danger" @onclick="Delete">Delete</button>
    }
</div>

@if (r.Error is not null)
{
    <div class="alert @(r.Status == RunStatus.Cancelled ? "alert-warn" : "alert-fail")">@r.Error</div>
}

@if (_run.LoginUrl is not null)
{
    <div class="alert alert-action">
        <b>Bank login needed.</b> A scenario is waiting for SCA. Open the bank's login page on this machine and log in with the sandbox user:
        <div><a class="btn btn-primary" href="@_run.LoginUrl" target="_blank">Open login page</a></div>
    </div>
}

<div class="tiles">
    <div class="tile"><b>@(TotalPassRate(completed))%</b>pass rate</div>
    <div class="tile"><b class="text-pass">@completed.Count(s => s.Outcome == Outcome.Passed)</b>passed</div>
    <div class="tile"><b class="text-fail">@completed.Count(s => s.Outcome == Outcome.Failed)</b>failed</div>
    <div class="tile"><b class="text-error">@completed.Count(s => s.Outcome == Outcome.Error)</b>errors</div>
    <div class="tile"><b>@completed.Count(s => s.Outcome == Outcome.Blocked)</b>blocked</div>
    <div class="tile"><b>@completed.Count(s => s.Outcome == Outcome.Skipped)</b>skipped</div>
</div>

@if (_run.IsActive)
{
    <div class="progress">
        <div class="progress-bar" style="width:@ProgressPercent%"></div>
    </div>
    <p class="muted small">
        @completed.Count of @(_run.TotalScenarios == 0 ? "?" : _run.TotalScenarios.ToString(CultureInfo.InvariantCulture)) done
        @if (_run.CurrentScenario is not null) { <span> · running <b>@_run.CurrentScenario</b></span> }
        @if (r.Status == RunStatus.Queued) { <span> · waiting for the previous run to finish</span> }
    </p>
}

@if (completed.Count > 0)
{
    <h2>Scenarios</h2>
    <div class="filter-row">
        @foreach (var f in new[] { "All", "Problems" })
        {
            <button class="chip @(_filter == f ? "chip-on" : "")" @onclick="() => _filter = f">@f</button>
        }
    </div>
    @foreach (var s in completed.Where(s => _filter == "All" || s.Outcome is not Outcome.Passed))
    {
        <ScenarioResultView Result="s" />
    }
}

@{ var log = _run.Log; }
@if (log.Count > 0)
{
    <details class="log" open="@_run.IsActive">
        <summary>Run log (@log.Count)</summary>
        <pre>@string.Join('\n', log)</pre>
    </details>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private PortalRun? _run;
    private string _filter = "All";

    private int ProgressPercent => _run is null || _run.TotalScenarios == 0 ? 3 : Math.Max(3, 100 * _run.Completed.Count / _run.TotalScenarios);

    protected override void OnParametersSet()
    {
        if (_run is not null)
            _run.Changed -= OnChanged;

        _run = RunService.Get(Id);
        if (_run is not null)
            _run.Changed += OnChanged;
    }

    private static string TotalPassRate(IReadOnlyList<ScenarioResult> completed)
    {
        var executed = completed.Count(s => s.Outcome is Outcome.Passed or Outcome.Failed);
        return executed == 0 ? "0" : (100.0 * completed.Count(s => s.Outcome == Outcome.Passed) / executed).ToString("0.#", CultureInfo.InvariantCulture);
    }

    private void RunAgain()
    {
        var run = RunService.Enqueue(_run!.Record.Request);
        Nav.NavigateTo($"/runs/{run.Id}");
    }

    private void Delete()
    {
        if (RunService.Delete(Id))
            Nav.NavigateTo("/runs");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_run is not null)
            _run.Changed -= OnChanged;
    }
}

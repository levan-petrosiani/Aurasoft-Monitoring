@page "/rules"
@using ApiTestTool.Store.Entities
@implements IDisposable
@inject RuleService RuleSvc

<PageTitle>Rules · API Test Portal</PageTitle>

<div class="title-row">
    <h1>Rules</h1>
    <ReviewerField @bind-Value="_reviewer" />
</div>
<p class="muted small">
    Requirements drafted from the standards. A draft only counts once a person approves it; every action is recorded with the reviewer's name.
    The quote of each rule was checked against the clause text by the tool; warnings below a rule are for the reviewer.
</p>

<div class="filter-row">
    @foreach (var s in Statuses)
    {
        <button class="chip @(_status == s ? "chip-on" : "")" @onclick="() => SetStatus(s)">@s <span class="muted">@Count(s)</span></button>
    }
    <select class="field field-inline" @bind="_standard" @bind:after="Load">
        <option value="">all standards</option>
        @foreach (var d in _all.Select(r => r.Standard).Distinct().Order())
        {
            <option value="@d">@d</option>
        }
    </select>
    <span class="right">
        <button class="btn btn-small btn-ghost" @onclick="Export" title="@RuleSvc.RulesDirectory">Export approved to rules/</button>
    </span>
</div>

@if (_message is not null)
{
    <div class="alert alert-action small">@_message</div>
}

@{ var shown = _all.Where(r => (_status == "all" || r.Status == _status) && (string.IsNullOrEmpty(_standard) || r.Standard == _standard)).ToList(); }
@if (shown.Count == 0)
{
    <p class="muted">No @(_status == "all" ? "" : _status) rules. Draft some from a clause on the <a href="/standards">Standards</a> page.</p>
}
@foreach (var r in shown)
{
    <RuleCard Rule="r" Reviewer="@_reviewer" Changed="Load" />
}

@code {
    private static readonly string[] Statuses = ["draft", "approved", "rejected", "invalid", "retired", "all"];

    private List<RuleEntity> _all = [];
    private string _status = "draft";
    private string _standard = "";
    private string? _reviewer;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        RuleSvc.Changed += OnChanged;
        await Load();
    }

    private async Task Load() => _all = await RuleSvc.Store.ListRulesAsync();

    private int Count(string status) => status == "all" ? _all.Count : _all.Count(r => r.Status == status);

    private void SetStatus(string status) => _status = status;

    private async Task Export()
    {
        var (written, removed) = await RuleSvc.ExportAsync();
        _message = $"{written} approved rule(s) written to {RuleSvc.RulesDirectory}, {removed} stale file(s) removed. Commit them to keep the history in git.";
    }

    private void OnChanged(string _) => InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose() => RuleSvc.Changed -= OnChanged;
}

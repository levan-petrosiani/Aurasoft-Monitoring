@page "/scenarios"
@inject CatalogService Catalog

<PageTitle>Scenarios · API Test Portal</PageTitle>

<h1>Scenarios</h1>
<p class="muted small">From <code>@Catalog.ScenariosDirectory</code>. Add a test by adding a YAML file there; the portal picks it up on the next run.</p>

@if (_error is not null)
{
    <div class="alert alert-fail"><pre>@_error</pre></div>
}

@foreach (var group in _scenarios.GroupBy(s => s.Suite).OrderBy(g => g.Key == ScenarioRunner.PreflightSuite ? 0 : 1).ThenBy(g => g.Key))
{
    <h2>@group.Key <span class="muted small">(@group.Count())</span></h2>
    <table class="grid">
        <thead><tr><th>ID</th><th>Title</th><th>Severity</th><th>Steps</th><th>Spec</th></tr></thead>
        <tbody>
            @foreach (var s in group.OrderBy(s => s.Id))
            {
                <tr>
                    <td><code>@s.Id</code></td>
                    <td>
                        @s.Title
                        @if (s.Requires is { Count: > 0 })
                        {
                            <div class="muted small">requires @string.Join(", ", s.Requires)</div>
                        }
                    </td>
                    <td><span class="sev sev-@s.Severity.ToLowerInvariant()">@s.Severity</span></td>
                    <td>@s.Steps.Count</td>
                    <td class="small">@s.SpecRef</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Scenario> _scenarios = [];
    private string? _error;

    protected override void OnInitialized()
    {
        try
        {
            _scenarios = Catalog.GetScenarios();
        }
        catch (ConfigurationException ex)
        {
            _error = ex.Message;
        }
    }
}

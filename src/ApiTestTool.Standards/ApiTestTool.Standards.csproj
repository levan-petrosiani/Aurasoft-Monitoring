<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standards documents → clauses: reads the Berlin Group PDF and the Georgian Word guides, splits them into numbered
    clauses, and checks that a quoted sentence really occurs in a clause. No AI and no database here.
  -->
  <PropertyGroup>
    <RootNamespace>ApiTestTool.Standards</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiTestTool.Standards.Tests" />
    <InternalsVisibleTo Include="ApiTestTool.AI.Tests" />
  </ItemGroup>

</Project>

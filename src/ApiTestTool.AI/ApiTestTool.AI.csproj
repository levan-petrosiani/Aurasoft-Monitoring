<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AI layer: model providers (Claude via the Anthropic SDK, local models via Ollama), masking and the audit log.
    The engine never references this project; AI only produces artifacts and answers, the engine runs tests.
  -->
  <PropertyGroup>
    <RootNamespace>ApiTestTool.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiTestTool.Store\ApiTestTool.Store.csproj" />
    <ProjectReference Include="..\ApiTestTool.Standards\ApiTestTool.Standards.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiTestTool.AI.Tests" />
  </ItemGroup>

</Project>

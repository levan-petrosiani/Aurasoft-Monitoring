{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "aqt: MOCK - all suites": {
      "commandName": "Project",
      "commandLineArgs": "run --bank MOCK --with-mock --sca-auto --verbose"
    },
    "aqt: MOCK - all suites (save to store)": {
      "commandName": "Project",
      "commandLineArgs": "run --bank MOCK --with-mock --sca-auto --verbose",
      "environmentVariables": { "AQT_DB": "Host=localhost;Port=5435;Database=aqt;Username=aqt;Password=aqt_dev" }
    },
    "aqt: MOCK - preflight": {
      "commandName": "Project",
      "commandLineArgs": "run --bank MOCK --with-mock --suite preflight --verbose"
    },
    "aqt: MOCK - negative": {
      "commandName": "Project",
      "commandLineArgs": "run --bank MOCK --with-mock --suite negative --verbose"
    },
    "aqt: MOCK - ais (log in in the browser)": {
      "commandName": "Project",
      "commandLineArgs": "run --bank MOCK --with-mock --suite ais --verbose"
    },
    "aqt: TBC mock (Vercel) - preflight + tbc": {
      "commandName": "Project",
      "commandLineArgs": "run --bank TBC-MOCK --suite preflight,tbc --sca-auto --verbose"
    },
    "aqt: mock bank only": {
      "commandName": "Project",
      "commandLineArgs": "mock"
    },
    "aqt: db migrate": {
      "commandName": "Project",
      "commandLineArgs": "db migrate"
    },
    "aqt: db import reports": {
      "commandName": "Project",
      "commandLineArgs": "db import reports"
    },
    "aqt: db status": {
      "commandName": "Project",
      "commandLineArgs": "db status"
    },
    "aqt: ai check": {
      "commandName": "Project",
      "commandLineArgs": "ai check",
      "environmentVariables": { "AQT_DB": "Host=localhost;Port=5435;Database=aqt;Username=aqt;Password=aqt_dev" }
    },
    "aqt: ai summarize latest (local model)": {
      "commandName": "Project",
      "commandLineArgs": "ai summarize latest --provider ollama"
    },
    "aqt: ai summarize latest (Claude)": {
      "commandName": "Project",
      "commandLineArgs": "ai summarize latest --provider anthropic"
    },
    "aqt: standards fetch + check": {
      "commandName": "Project",
      "commandLineArgs": "standards fetch"
    },
    "aqt: standards ingest": {
      "commandName": "Project",
      "commandLineArgs": "standards ingest"
    },
    "aqt: rules draft GE 9.1.1.10 (local model)": {
      "commandName": "Project",
      "commandLineArgs": "rules draft GE-XS2A:0.8.RC3:9.1.1.10 --provider ollama"
    },
    "aqt: rules list drafts": {
      "commandName": "Project",
      "commandLineArgs": "rules list --status draft"
    },
    "aqt: validate": {
      "commandName": "Project",
      "commandLineArgs": "validate"
    },
    "aqt: list scenarios": {
      "commandName": "Project",
      "commandLineArgs": "list scenarios"
    },
    "aqt: help": {
      "commandName": "Project",
      "commandLineArgs": "help"
    }
  }
}
